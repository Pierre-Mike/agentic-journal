---
/**
 * Header toggle that flips `data-theme` on `<html>` and persists the choice
 * to `localStorage.theme`. Initial glyph + sr-only state are set here based
 * on the default server-rendered `data-theme="light"`; the client script
 * (below) re-syncs them to the real theme after the inline head script has
 * resolved it, and keeps them in sync on click.
 *
 * Accessibility: `aria-label="Toggle color theme"` is the stable name used
 * by the e2e selector (`getByRole("button", { name: /toggle color theme/i })`)
 * and by screen readers. The `<span data-theme-label>` gives AT users the
 * current state in words; it is visually hidden via the `sr-only` class.
 */
---

<button
	type="button"
	class="theme-toggle"
	aria-label="Toggle color theme"
	data-theme-toggle
>
	<span aria-hidden="true" data-theme-glyph>☀</span>
	<span class="sr-only" data-theme-label>currently light</span>
</button>

<style>
	.theme-toggle {
		background: transparent;
		border: 1px solid var(--muted);
		color: var(--fg);
		cursor: pointer;
		font: inherit;
		padding: 0.2rem 0.5rem;
		border-radius: 4px;
		line-height: 1;
	}
	.theme-toggle:hover {
		border-color: var(--fg);
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>

<script>
	import { nextTheme, type Theme } from "../lib/theme";

	function asTheme(value: string | undefined): Theme {
		return value === "dark" ? "dark" : "light";
	}

	function sync(theme: Theme): void {
		const glyph = document.querySelector<HTMLElement>("[data-theme-glyph]");
		const label = document.querySelector<HTMLElement>("[data-theme-label]");
		if (glyph) glyph.textContent = theme === "dark" ? "☾" : "☀";
		if (label) label.textContent = `currently ${theme}`;
	}

	// The inline head script in BaseLayout has already resolved and set
	// `data-theme` by the time this client module runs — re-sync the glyph
	// and sr-only label to match.
	sync(asTheme(document.documentElement.dataset.theme));

	const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
	if (button) {
		button.addEventListener("click", () => {
			const current = asTheme(document.documentElement.dataset.theme);
			const next = nextTheme(current);
			document.documentElement.dataset.theme = next;
			try {
				window.localStorage.setItem("theme", next);
			} catch {
				// localStorage may be unavailable (private mode, quota). The
				// in-memory `data-theme` still flips; persistence just degrades.
			}
			sync(next);
		});
	}
</script>
