---
// biome-ignore-all lint/correctness/noUnusedImports: template-only references in .astro
// biome-ignore-all lint/correctness/noUnusedVariables: template-only references in .astro
import { getCollection, render } from "astro:content";
import SEOHead from "../../components/SEOHead.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { readingTime } from "../../lib/reading-time";

export async function getStaticPaths() {
	const posts = await getCollection("posts");
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { minutes } = readingTime(post.body ?? "");

if (Astro.site === undefined) {
	throw new Error("Astro.site must be configured for canonical URLs");
}
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<BaseLayout title={post.data.title} description={post.data.summary}>
	<SEOHead
		slot="head"
		title={post.data.title}
		description={post.data.summary}
		url={canonical}
		datePublished={post.data.date.toISOString()}
		tags={post.data.tags}
	/>
	<article>
		<h1>{post.data.title}</h1>
		<p style="color: var(--muted)">
			{post.data.date.toISOString().slice(0, 10)} · spec {post.data.spec_id} · {minutes} min read
		</p>
		<Content />
	</article>
</BaseLayout>
